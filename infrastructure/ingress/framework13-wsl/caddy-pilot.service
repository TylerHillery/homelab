[Unit]
Description=Caddy tailnet ingress loopback pilot
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/personal/homelab/infrastructure/ingress/framework13-wsl
LoadCredential=cloudflare-token:%h/.config/homelab/credentials/caddy-cloudflare-token
ExecStart=/bin/bash %h/code/personal/homelab/infrastructure/ingress/framework13-wsl/run-pilot.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
