{
	auto_https disable_redirects
}

# Tailscale Serve forwards tailnet TCP 443 to this loopback TLS listener.
https://opencode.framework13-wsl.homelab.tylertries.com:8444 {
	bind 127.0.0.1
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	reverse_proxy 127.0.0.1:4096
}

https://hlims.staging.framework13-wsl.homelab.tylertries.com:8444 {
	bind 127.0.0.1
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	reverse_proxy 127.0.0.1:8081
}
