amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

steps {
  ["merge-conflicts"] = Builtins.check_merge_conflict
  ["toml"] = Builtins.taplo
  ["shell-format"] = Builtins.shfmt
  ["yaml"] = (Builtins.yamllint) {
    check = "yamllint -d '{rules: {}}' {{files}}"
  }
  ["newlines"] = (Builtins.newlines) {
    exclude = List(
      "services/hlims/console/static/htmx-*.min.js",
      "services/hlims/console/static/swagger-ui-*"
    )
  }
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["hlims-format"] {
    glob = "services/hlims/**/*.go"
    check = "mise //services/hlims:format-check"
  }
  ["hlims-generate"] {
    glob = Regex(#"^services/hlims/(api/|db/|generated/|sqlc\.yaml$)"#)
    check = "mise //services/hlims:generate-check"
  }
  ["hlims-lint"] {
    glob = "services/hlims/**/*.go"
    check = "mise //services/hlims:lint"
  }
  ["hlims-test"] {
    glob = "services/hlims/**"
    check = "mise //services/hlims:test"
  }
  ["sql-lint"] {
    glob = "services/hlims/db/**/*.sql"
    check = "mise //services/hlims:sql:lint"
  }
  ["ubuntu-ansible-check"] {
    glob = List("infrastructure/ansible/**/*.yml", "infrastructure/ansible/**/*.yaml", "infrastructure/ansible/**/*.toml", "infrastructure/ansible/**/*.cfg", "infrastructure/ansible/uv.lock")
    check = "mise //infrastructure/ansible:check"
  }
  ["opentofu-check"] {
    glob = List("infrastructure/opentofu/**/*.tf", "infrastructure/opentofu/**/*.tf.json", "infrastructure/opentofu/**/*.tfvars", "infrastructure/opentofu/**/*.tfvars.json", "infrastructure/opentofu/**/.terraform.lock.hcl", "infrastructure/opentofu/**/.tflint.hcl", "infrastructure/opentofu/**/mise.toml")
    check = "mise //infrastructure/opentofu/...:check"
  }
  ["ingress-check"] {
    glob = List("infrastructure/ingress/**/*.toml", "infrastructure/ingress/**/Caddyfile", "infrastructure/ansible/roles/caddy/**/*.yml", "infrastructure/ansible/roles/caddy/**/*.j2", "infrastructure/ansible/roles/caddy/**/*.sh")
    check = "mise //infrastructure/ingress/framework13-wsl:check"
  }
}
